{
  "name": "social-mcp",
  "version": "0.1.0",
  "description": "Local, clone-and-run MCP server + autonomous scheduler for managing social media accounts via official APIs.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "social-media",
    "scheduler",
    "linkedin",
    "instagram",
    "facebook",
    "threads",
    "youtube",
    "claude"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "social-mcp": "dist/bin/cli.js",
    "social-mcp-server": "dist/bin/mcp-server.js",
    "social-mcp-daemon": "dist/bin/daemon.js",
    "social-mcp-dashboard": "dist/bin/dashboard.js"
  },
  "files": [
    "dist",
    "config.example.json",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/bin/cli.ts",
    "mcp": "tsx src/bin/mcp-server.ts",
    "daemon": "tsx src/bin/daemon.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^13.1.0",
    "croner": "^9.0.0",
    "open": "^10.1.0",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
